# LLM Configuration (OpenAI, Gemini, Anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_gemini_key_here
LLM_MODEL=gpt-4o-mini

# Gnani.ai Speech Services Configuration (Step 4 Voice Integration)
# Sign up and generate your API key at: https://app.gnani.ai/voice
# One key covers both STT and TTS services.
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_LANGUAGE_CODE=en-IN

# Adaptive Retrieval Configuration
DATASET_DIR=Capstone_Project_Dataset_FTTT_2026
OUTPUT_DIR=sample_outputs
DEFAULT_STRATEGY=adaptive
DEFAULT_TOP_K=5
CONFIDENCE_THRESHOLD=0.18
